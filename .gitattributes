# 统一换行符为 LF（抵消 Windows 上 core.autocrlf=true 的 CRLF 抖动）。
# gitattributes 的 eol 规则优先级高于 core.autocrlf，因此本文件即已足够。
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.wav binary
*.mp3 binary
*.gguf binary
*.db binary
*.vrm binary
*.unitypackage binary

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 锁文件在 diff 中折叠
uv.lock linguist-generated=true
