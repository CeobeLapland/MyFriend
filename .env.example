# Astra 配置示例。
#
# 用法：Copy-Item .env.example .env，然后按需修改。
# `.env` 已被 .gitignore 忽略，不要提交。
#
# 注意：Settings 使用 extra="forbid"，因此下面**未被注释的键**必须与
# src/astra/settings.py 中的字段一一对应。预留但尚未实现的键请保持注释状态。

# ── 运行环境 ────────────────────────────────────────────
# dev | test | prod
# 只有 dev 会挂载开发者控制台 GET /dev。若把 ASTRA_HTTP_HOST 改成 0.0.0.0
# 暴露到局域网，请同时把这里设成 prod。
ASTRA_ENV=dev

# ── 日志 ────────────────────────────────────────────────
ASTRA_LOG_LEVEL=INFO
ASTRA_LOG_FORMAT=json
# 留空表示只输出到 stdout
ASTRA_LOG_FILE=

# ── HTTP ────────────────────────────────────────────────
ASTRA_HTTP_HOST=127.0.0.1
ASTRA_HTTP_PORT=8000

# ── 数据 ────────────────────────────────────────────────
ASTRA_DATA_DIR=./data
ASTRA_DB_PATH=./data/astra.db
ASTRA_COMPANION_ID=astra
# M1 还没有 users 表，用一个固定本地用户标识
ASTRA_USER_ID=local
# 人格配置（随仓库分发，不是用户数据）
ASTRA_PERSONA_PATH=./personas/astra.toml
# 空闲多久后自动结束当前会话并新开一个
ASTRA_CONVERSATION_IDLE_MINUTES=60

# ── LLM ─────────────────────────────────────────────────
# none = 不连接任何 LLM（/health 会诚实上报 not_configured）
# lmstudio = 接入本地 LM Studio
ASTRA_LLM_PROVIDER=none
ASTRA_LLM_BASE_URL=http://localhost:1234/v1
ASTRA_LLM_API_KEY=lm-studio-local
ASTRA_LLM_MODEL=qwen/qwen3.5-9b
# 显存不足时的降级模型（8GB VRAM 场景）
ASTRA_LLM_FALLBACK_MODEL=nvidia/nemotron-3-nano-4b
ASTRA_LLM_CONNECT_TIMEOUT_S=5
ASTRA_LLM_REQUEST_TIMEOUT_S=120
ASTRA_LLM_MAX_TOKENS=400
ASTRA_LLM_TEMPERATURE=0.7
# 思考深度：none | low | medium | high
# 默认 none —— qwen3.5-9b 开思考时一次问候要 15.4s，关掉后 3.4s。
# 注意 enable_thinking=false 与 /no_think 都无效，只有这个参数管用。
ASTRA_LLM_REASONING_EFFORT=none
# 上下文窗口预算（按字符计，不是 token —— 本地没有 qwen 的词表）
ASTRA_LLM_HISTORY_MAX_MESSAGES=20
ASTRA_LLM_HISTORY_MAX_CHARS=12000

# ── 健康检查 ────────────────────────────────────────────
ASTRA_HEALTH_PROBE_TIMEOUT_S=2.0
# DB 不可用是否算整体 down（true）还是仅 degraded（false）
ASTRA_HEALTH_DB_REQUIRED=true

# ── Embedding（M2）──────────────────────────────────────
# none = 不向量化（记忆子系统降级为「不检索、不写入」，聊天不受影响）
# lmstudio = 走本地 LM Studio 的 /v1/embeddings
ASTRA_EMBEDDING_PROVIDER=none
ASTRA_EMBEDDING_BASE_URL=http://localhost:1234/v1
ASTRA_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# 必须与迁移 0003 里 memory_vectors 的 float[N] 一致，否则启动会直接失败。
# 实测 text-embedding-nomic-embed-text-v1.5 输出 768 维。
ASTRA_EMBEDDING_DIM=768
ASTRA_EMBEDDING_TIMEOUT_S=30.0

# ── Memory（M2）─────────────────────────────────────────
# 启动期默认值。运行时可改：PUT /v1/memories/settings {"enabled": false}
ASTRA_MEMORY_ENABLED=true
# 每轮注入 prompt 的记忆条数上限
ASTRA_MEMORY_TOP_K=5
# KNN 过采样数（重排序后再截断到 TOP_K）
ASTRA_MEMORY_CANDIDATE_LIMIT=20
# 一轮对话最多落库几条候选
ASTRA_MEMORY_MAX_CANDIDATES_PER_TURN=3
# 余弦相似度超过它就合并而不是新建
ASTRA_MEMORY_DEDUP_THRESHOLD=0.90
# 准入闸门：原始余弦相似度低于它的记忆根本不进 prompt（不是排序分）
# 实测相关对 0.64-0.83、无关对 0.62-0.74（重叠），0.70 取偏严的一侧
ASTRA_MEMORY_MIN_SIMILARITY=0.70
# 注入 prompt 的记忆层字符预算
ASTRA_MEMORY_CONTEXT_MAX_CHARS=2000

# ── State（M3）─────────────────────────────────────────
# 情绪衰减半衰期（分钟）。这个值缺乏依据，需要评测调参。
ASTRA_STATE_EMOTION_DECAY_HALF_LIFE_MINUTES=120
# 朝「已表达情绪的目标水平」靠拢的比例（0 = 完全不受表达影响）。
# 注意：这是**比例靠拢**，不是加法——加法会形成正反馈把情绪顶到 1.0。
ASTRA_STATE_EMOTION_PULL=0.15

# 检索**排序**权重（docs/06 §4）——**五者之和必须为 1.0**，否则启动直接失败。
# 注意：它们只影响排序，不影响准入（准入由 ASTRA_MEMORY_MIN_SIMILARITY 决定）。
ASTRA_MEMORY_WEIGHT_SEMANTIC=0.50
ASTRA_MEMORY_WEIGHT_IMPORTANCE=0.20
ASTRA_MEMORY_WEIGHT_RECENCY=0.15
ASTRA_MEMORY_WEIGHT_ACCESS=0.05
ASTRA_MEMORY_WEIGHT_RELATIONSHIP=0.10

# ── Audio（M4）──────────────────────────────────────────
# none = 不接入（/health 诚实上报 not_configured，文本路径完全不受影响）
# cosyvoice = CosyVoice3 雨落版整合包（一个 Gradio 应用，见 ADR 0009/0022）
ASTRA_STT_PROVIDER=none
ASTRA_TTS_PROVIDER=none
# 雨落版 Gradio 应用的地址。STT 与 TTS 是同一个进程，所以共用一个 URL。
ASTRA_TTS_BASE_URL=http://127.0.0.1:7860
# /rainfall_gen_sft 的预训练音色名（雨落版当前只列出「开拓者」）
ASTRA_TTS_VOICE=开拓者
# ★ zero-shot 音色克隆的参考音频（≤30 秒的干净人声，单声道 wav 最好）。
#   配了它就走 /rainfall_gen_zero_shot；留空则退回上面的预置音色。
#
#   **推荐配一个**：M4 真机验收实测，雨落版的预置音色「开拓者」念出来像乱码，
#   而 zero-shot 对同一段文本效果正常。参考音频对应的文本由
#   /prompt_wav_recognition 自动识别，不用手打。
ASTRA_TTS_REFERENCE_AUDIO=
# 首次调用含模型加载（实测 TTS 冷启 ~5s、STT 冷启 ~4.9s），别设太紧
ASTRA_TTS_TIMEOUT_S=120
ASTRA_STT_TIMEOUT_S=120
# 客户端采集格式。16 kHz 单声道 int16 是 SenseVoice 的输入惯例。
# 注意：服务端**不做重采样**——客户端在 input.audio.started 里声明的格式
# 与这里不符会被直接拒绝（error.protocol）。
ASTRA_AUDIO_INPUT_SAMPLE_RATE=16000
ASTRA_AUDIO_INPUT_CHANNELS=1
# 单个 WS 二进制帧的字节上限（收发双向）
ASTRA_AUDIO_CHUNK_MAX_BYTES=65536
# 一次 utterance 的时长上限；超过就截断并记日志（防呆，不是功能）
ASTRA_AUDIO_MAX_UTTERANCE_SECONDS=60
# VAD 是**占位实现**：固定阈值的 RMS 能量检测 + 静音超时自动结束。
# 没有降噪、没有自适应噪声门限。**默认关闭**——M4 真机验收实测它在自然停顿处
# 就会误判"说完了"（"你好呀，今天过得怎么样？"在逗号处被截断），而 M4 的输入
# 路径本来就是 push-to-talk（客户端一定会发 input.audio.stopped）。
# 想做"免按键"时再打开，届时它需要的是正经 VAD 而不是调大这个阈值。
ASTRA_VAD_ENABLED=false
ASTRA_VAD_SILENCE_MS=800
ASTRA_VAD_ENERGY_THRESHOLD=0.01

# ⚠️ 8 GB 显存下的硬约束（M4 实测）：LM Studio 的 LLM 与 CosyVoice **不能同时
# 常驻 GPU 且都快**。LLM 满 GPU 时 TTS 从 2–4 s/句 劣化到 10–30 s/句。
# 所以让 LLM 走 CPU，把 GPU 整个让给音频模型：
#
#   lms load nvidia/nemotron-3-nano-4b --gpu off --context-length 16384
#
# 代价：纯文本聊天从 3–5 s 变成 6–10 s。这条是**环境配置，代码无法检测**——
# 忘记加 --gpu off 时 TTS 会很慢，而 /health 不会报错。见 ADR 0022。

# ── 以下为后续里程碑预留，当前不读取 ───────────────────
# 在对应里程碑实现 Settings 字段后再取消注释，否则 extra="forbid" 会导致启动失败。
#
# ASTRA_AVATAR_ENABLED=false
# ASTRA_TIMEZONE=Asia/Shanghai
